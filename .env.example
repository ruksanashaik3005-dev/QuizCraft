# Copy this file to the project-root .env. Keep real credentials out of source control.
# Groq exposes an OpenAI-compatible API and offers a free developer tier;
# check current account limits and available models in the provider console.
GROQ_API_KEY=your-key-from-the-provider-console
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b
LLM_TIMEOUT_SECONDS=60

# Optional: choose where Chroma stores locally embedded study chunks.
# QUIZCRAFT_VECTOR_DIR=.quizcraft/chroma

# Authentication API. Environment variables supplied by the process/container
# take precedence over values loaded from this file.
QUIZCRAFT_DATABASE_URL=sqlite:///./.quizcraft/quizcraft.db
QUIZCRAFT_FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
QUIZCRAFT_COOKIE_SECURE=false
QUIZCRAFT_COOKIE_SAMESITE=lax

# Production checklist:
# - Use a managed database URL and persistent storage for Chroma data.
# - Set QUIZCRAFT_FRONTEND_ORIGINS to exact deployed frontend origins only.
# - Serve over HTTPS and set QUIZCRAFT_COOKIE_SECURE=true.
# - Secure cookies always use SameSite=None for the separate frontend/API
#   deployment; this is required for the browser to send API cookies.
# - Configure VITE_API_BASE_URL in frontend/.env at build time when the API
#   does not share the frontend origin. Never put API keys in frontend config.
